{
  "name": "paymood-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter paymood build",
    "typecheck": "pnpm --filter paymood typecheck",
    "test": "vitest run --maxWorkers=2 --dir test && pnpm run test:webview && pnpm --filter paymood test",
    "test:webview": "vitest run --maxWorkers=2 --dir vscode-extension/test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "prettier": "^2.0.0",
    "repo-context-kit": "^1.8.4",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
